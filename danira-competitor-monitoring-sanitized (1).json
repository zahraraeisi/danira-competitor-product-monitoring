      "name": "Keep Active Products Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        448,
        80
      ]
    },
    {
      "parameters": {
        "resource": "extraction",
        "operation": "query",
        "sessionMode": "new",
        "url": "={{ $json.product_url }}",
        "prompt": "Extract the product name, the current selling price (number only, plus the currency), and the stock status (e.g. in stock, out of stock) from this product page.",
        "additionalFields": {
          "outputSchema": "{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"product_name\":{\"type\":\"string\"},\"price\":{\"type\":\"number\"},\"stock_status\":{\"type\":\"string\"},\"error\":{\"type\":\"string\",\"description\":\"Reason the product data could not be extracted, if applicable\"}},\"required\":[\"product_name\",\"price\",\"stock_status\"],\"additionalProperties\":false}",
          "parseJsonOutput": true
        }
      },
      "id": "4aa5131e-ff6e-42c8-8a2d-e285567ab321",
      "name": "Extract Product Data With Airtop",
      "type": "n8n-nodes-base.airtop",
      "typeVersion": 1.1,
      "position": [
        896,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "product_id",
              "type": "number",
              "value": "={{ $('Process Each Product Individually').item.json.id }}"
            },
            {
              "id": "f2",
              "name": "competitor_name",
              "type": "string",
              "value": "={{ $('Process Each Product Individually').item.json.competitor_name }}"
            },
            {
              "id": "f3",
              "name": "competitor_url",
              "type": "string",
              "value": "={{ $('Process Each Product Individually').item.json.product_url }}"
            },
            {
              "id": "f4",
              "name": "product_name",
              "type": "string",
              "value": "={{ $json.output.product_name }}"
            },
            {
              "id": "f5",
              "name": "current_price",
              "type": "number",
              "value": "={{ $json.output.price }}"
            },
            {
              "id": "f6",
              "name": "stock_status",
              "type": "string",
              "value": "={{ $json.output.stock_status }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a88de5d5-321e-493e-9ef0-3f0024477a4e",
      "name": "Structure Extracted Product Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1120,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const current = $json;\nconst prev = $('Process Each Product Individually').item.json;\n\nconst toNum = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  const n = parseFloat(String(v).replace(/[^0-9.\\-]/g, ''));\n  return Number.isFinite(n) ? n : null;\n};\nconst stockState = (v) => {\n  const s = String(v === null || v === undefined ? '' : v).trim().toLowerCase();\n  if (!s) return null;\n  if (/out of stock|sold out|unavailable|not available|out-of-stock|no stock/.test(s)) return 'out';\n  if (/in stock|available|in-stock|ready to ship/.test(s)) return 'in';\n  return 'unknown';\n};\n\nconst previousPrice = toNum(prev.last_price);\nconst currentPrice = toNum(current.current_price);\nconst prevStock = stockState(prev.last_stock_status);\nconst currStock = stockState(current.stock_status);\n\nlet priceChangePercent = null;\nif (previousPrice !== null && previousPrice !== 0 && currentPrice !== null) {\n  priceChangePercent = Math.round(((currentPrice - previousPrice) / previousPrice) * 10000) / 100;\n}\n\nlet eventType = 'NO_CHANGE';\nif (previousPrice === null && prevStock === null) {\n  eventType = 'INITIAL';\n} else if (prevStock === 'in' && currStock === 'out') {\n  eventType = 'OUT_OF_STOCK';\n} else if (prevStock === 'out' && currStock === 'in') {\n  eventType = 'BACK_IN_STOCK';\n} else if (previousPrice !== null && currentPrice !== null && currentPrice < previousPrice) {\n  eventType = 'PRICE_DOWN';\n} else if (previousPrice !== null && currentPrice !== null && currentPrice > previousPrice) {\n  eventType = 'PRICE_UP';\n}\n\nreturn {\n  json: {\n    ...current,\n    previous_price: previousPrice,\n    previous_stock_status: prev.last_stock_status === undefined || prev.last_stock_status === '' ? null : prev.last_stock_status,\n    event_type: eventType,\n    price_change_percent: priceChangePercent,\n  },\n};"
      },
      "id": "a711ff22-cdef-4102-8f32-8705b1828a5b",
      "name": "Compare With Previous Values",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        272
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "alert-event",
              "leftValue": "={{ ['PRICE_DOWN','PRICE_UP','OUT_OF_STOCK','BACK_IN_STOCK'].includes($json.event_type) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "8823a952-2596-4dc0-b1b5-b9533bf66b96",
      "name": "Is Alert Event",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1568,
        -48
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=Competitor Alert\n\nEvent: {{ $('Compare With Previous Values').item.json.event_type }}\nCompetitor: {{ $('Compare With Previous Values').item.json.competitor_name }}\nProduct: {{ $('Compare With Previous Values').item.json.product_name }}\n\nPrevious price: {{ $('Compare With Previous Values').item.json.previous_price ?? 'N/A' }}\nCurrent price: {{ $('Compare With Previous Values').item.json.current_price ?? 'N/A' }}\nPrice change: {{ $('Compare With Previous Values').item.json.price_change_percent ?? 'N/A' }}%\n\nPrevious stock status: {{ $('Compare With Previous Values').item.json.previous_stock_status ?? 'N/A' }}\nCurrent stock status: {{ $('Compare With Previous Values').item.json.stock_status ?? 'N/A' }}\n\nURL: {{ $('Compare With Previous Values').item.json.competitor_url }}",
        "replyMarkup": "=",
        "forceReply": {},
        "replyKeyboardOptions": {},
        "replyKeyboardRemove": {},
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
